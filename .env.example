# ============================================================
#  Access360 — Environment Variables
#  Copy this file and fill in your values.
#  DO NOT commit .env.local — only commit this .env.example
# ============================================================

# --- Neon PostgreSQL (Main Database) ---
# Get from: https://console.neon.tech → Connection String
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# --- NextAuth ---
# NEXTAUTH_URL = your production URL (Render gives you: https://access360.onrender.com)
NEXTAUTH_URL=https://YOUR_APP_NAME.onrender.com
# Generate a secret: run `openssl rand -base64 32` or use any long random string
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# --- Admin Registration ---
# Users who enter this code on sign-up get admin role
ADMIN_SECRET_CODE=112233

# --- Groq AI ---
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY

# --- Admin Promotion Endpoint (optional) ---
# Used to promote a user to admin via POST /api/admin/setup
ADMIN_SETUP_SECRET=access360-admin-2024

# --- Node Environment ---
NODE_ENV=production
